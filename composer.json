{
  "name": "itinerisltd/controller",
  "type": "package",
  "license": "MIT",
  "description": "WordPress package to enable a basic controller when using Blade with Sage 9, maintained by Itineris to support legacy sites",
  "homepage": "https://github.com/ItinerisLtd/sage-9-controller",
  "authors": [
    {
      "name": "Darren Jacoby",
      "email": "darren@jacoby.co.za",
      "homepage": "https://github.com/darrenjacoby"
    },
    {
      "name": "codepuncher",
      "email": "lee.hanbury@gmail.com",
      "homepage": "https://github.com/codepuncher"
    },
    {
      "name": "Itineris Limited",
      "homepage": "https://github.com/ItinerisLtd"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "support": {
    "issues": "https://github.com/ItinerisLtd/sage-9-controller/issues"
  },
  "require": {
    "php": ">=8.4",
    "brain/hierarchy": "^3.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Sober\\Controller\\": "src/"
    },
    "files": [
      "controller.php"
    ]
  },
  "scripts": {
    "test": [
      "phpcs --extensions=php --ignore=vendor/ ."
    ]
  }
}
